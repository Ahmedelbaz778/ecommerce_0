extends /layouts/_pages

block vars
  -
    page = {
      title: "Loading Product...",
      breadcrumbs: {
        'Catalog': 'catalog.html'
      }
    }

block pages
  div(class="uk-grid-medium uk-child-width-1-1" uk-grid)
    div
      div(class="uk-card uk-card-default uk-card-small tm-ignore-container")
        div(class="uk-grid-small uk-grid-collapse uk-grid-match" uk-grid)

          // Media Section
          div(class="uk-width-expand@m")
            div(class="uk-grid-collapse uk-child-width-1-1" uk-slideshow="finite: true; ratio: 4:3;" id="product-slideshow" uk-grid)
              div
                ul#slideshow-items-container.uk-slideshow-items(uk-lightbox)
                  li
                    a.uk-card-body.tm-media-box.tm-media-box-zoom(href="#")
                      figure.tm-media-box-wrap
                        img#primary-product-image(src="" alt="Loading image...")
              div#slideshow-thumbnails-container
                div.uk-card-body.uk-flex.uk-flex-center
                  div(class="uk-width-1-2 uk-visible@s")
                    div(uk-slider="finite: true" id="product-thumbnails-slider")
                      div.uk-position-relative
                        div.uk-slider-container
                          ul#slider-thumbnails-list.tm-slider-items.uk-slider-items.uk-child-width-1-4.uk-grid.uk-grid-small
                        div
                          a.uk-position-center-left-out.uk-position-small(href="#" uk-slider-item="previous" uk-slidenav-previous)
                          a.uk-position-center-right-out.uk-position-small(href="#" uk-slider-item="next" uk-slidenav-next)
                  ul#slideshow-dotnav-container(class="uk-slideshow-nav uk-dotnav uk-hidden@s")

          // Info Section
          div(class="uk-width-1-1 uk-width-1-3@m tm-product-info")
            div.uk-card-body

              // Brand
              div#product-brand-section
                a#product-brand-link(href="#" title="Brand Name")
                  img#product-brand-image(src="" alt="Brand" style="height: 40px;")

              // Rating & Status
              div.uk-margin
                div.uk-grid-small(uk-grid)
                  div.uk-flex.uk-flex-middle
                    ul#product-rating-stars.uk-iconnav.uk-margin-xsmall-bottom.tm-rating
                    div.uk-margin-xsmall-left
                      a#product-review-count-link.uk-text-meta.js-scroll-to-description(href="#description" onclick="UIkit.switcher('.js-product-switcher').show(3);") (0)
                  div#product-statuses-container

              // Variations
              div.uk-margin#product-variations-section

              // Shop Section
              div.uk-margin
                div.uk-padding-small.uk-background-primary-lighten.uk-border-rounded
                  div.uk-grid-small.uk-child-width-1-1(uk-grid)
                    div
                      div.uk-text-muted#product-availability-message Product status loading...
                      del#product-old-price.uk-text-meta(style="display:none;")
                      div#product-price.tm-product-price
                    div#add-to-cart-section
                      div.uk-grid-small.uk-child-width-auto.uk-flex-middle.uk-flex(uk-grid)
                        div
                          input#product-quantity-input.uk-input.uk-form-width-xsmall(type="number" min="1" value="1")
                        div
                          button.uk-button.uk-button-primary(type="button" onclick="handleAddToCart()")
                            span(uk-icon="cart" class="uk-margin-small-right")
                            | أضف إلى السلة
                        div.uk-flex.uk-flex-middle
                          a#favorite-button.uk-margin-small-right.js-add-to.js-add-to-favorites(uk-tooltip="Add to favorites")
                            span(uk-icon="heart")
                          a#compare-button.js-add-to.js-add-to-compare(uk-tooltip="Add to compare")
                            span(uk-icon="copy")

              // Delivery Info
              div.uk-margin
                div.uk-padding-small.uk-background-muted.uk-border-rounded
                  div.uk-grid-small.uk-child-width-1-1.uk-text-small(uk-grid)
                    div
                      div.uk-grid-collapse(uk-grid)
                        span(uk-icon="cart" class="uk-margin-xsmall-right")
                        div
                          div.uk-text-bolder Delivery
                          div.uk-text-xsmall.uk-text-muted#delivery-info-text In stock, free, tomorrow
                    div
                      div.uk-grid-collapse(uk-grid)
                        span(uk-icon="location" class="uk-margin-xsmall-right")
                        div
                          div.uk-text-bolder Pick up from store
                          div.uk-text-xsmall.uk-text-muted#pickup-info-text In stock, free, tomorrow

              // Properties
              div.uk-margin
                ul#product-properties-summary-list.uk-list.uk-text-small.uk-margin-remove
                div.uk-margin-small-top
                  a.uk-link-heading.js-scroll-to-description(href="#description" onclick="UIkit.switcher('.js-product-switcher').show(1);")
                    span.tm-pseudo Detailed specifications
                    span.uk-margin-xsmall-left(uk-icon="chevron-down" ratio=".75")

          // Description Tabs
          div#description(class="uk-width-1-1 tm-product-description")
            header
              nav.tm-product-nav(uk-sticky="offset: 60; bottom: #description; cls-active: tm-product-nav-fixed;")
                ul.js-product-switcher.uk-subnav.uk-subnav-pill(uk-switcher="connect: .js-tabs")
                  li: a.js-scroll-to-description(href="#description") Overview
                  li: a.js-scroll-to-description(href="#description") Specifications
                  li: a.js-scroll-to-description(href="#description") Accessories
                    span#accessories-count-badge
                  li: a.js-scroll-to-description(href="#description") Reviews
                    span#reviews-count-badge
                  li: a.js-scroll-to-description(href="#description") Q&A
            div.uk-card-body
              div.js-product-switcher.js-tabs.uk-switcher
                section#overview-tab-content
                  article.uk-article
                    div.uk-article-body
                      p#product-description Loading overview...
                section#specifications-tab-content
                  p Loading specifications...
                section#accessories-tab-content
                  div.tm-wrapper
                    div#accessories-grid(class="uk-grid-collapse uk-child-width-1-3@s uk-child-width-1-4@m tm-products-grid" uk-grid)
                      p Loading accessories...
                section#reviews-tab-content
                  div.uk-grid-small.uk-grid-divider(uk-grid)
                    div(class="uk-width-1-1 uk-width-1-5@s uk-text-center tm-reviews-column" id="average-rating-display")
                      p Loading ratings...
                    div(class="uk-width-1-1 uk-width-expand@s" id="reviews-list-items-container")
                      p Loading reviews...
                section#qna-tab-content
                  ul#qna-accordion.uk-list-divider.uk-list-large(uk-accordion="multiple: true")
                    li Loading Q&A...

    // Related Products
    section#related-products-section
      div(uk-slider="finite: true")
        div(class="uk-grid-small uk-flex-middle uk-margin-bottom" uk-grid)
          h2(class="uk-width-expand uk-text-center uk-text-left@s") Related Products
          div(class="uk-visible@s")
            a.tm-slidenav(href="#" uk-slider-item="previous" uk-slidenav-previous)
            a.tm-slidenav(href="#" uk-slider-item="next" uk-slidenav-next)
        div
          div(class="uk-card uk-card-default uk-card-small tm-ignore-container")
            div.uk-position-relative
              div.uk-slider-container
                div#related-products-slider-grid(class="uk-slider-items uk-grid-collapse uk-child-width-1-3 uk-child-width-1-4@m tm-products-grid")
                  p Loading related products...
          ul(class="uk-slider-nav uk-dotnav uk-flex-center uk-margin-top uk-hidden@s")

    // Error & Loading UI
    div#error-container(style="display: none;")
    div.loading-state(style="display:none")
      div.uk-text-center.uk-padding
        span.uk-margin-small-right(uk-spinner)
        | جاري تحميل تفاصيل المنتج...

    // ✅ Offcanvas (السلة الجانبية)
    div#cart-offcanvas.uk-offcanvas.uk-offcanvas-overlay(uk-offcanvas="overlay: true")
      div.uk-offcanvas-bar
        button.uk-offcanvas-close(type="button" uk-close)
        h3.uk-heading-bullet سلة المشتريات
        div#cart-items-container
          p.uk-text-muted سلتك فارغة.
        div#cart-summary.uk-margin-top
          hr
          div.uk-flex.uk-flex-between
            span.uk-text-bold المجموع:
            span#cart-subtotal $0.00
          a.uk-button.uk-button-primary.uk-margin-top.uk-width-1-1(href="checkout.html") إتمام الشراء

  // JS Script
  include /partials/_cart-offcanvas
  script(src="scripts/product.js")
