doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Register - Online Store
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet")
    style.
      * {
        box-sizing: border-box;
        font-family: 'Inter', sans-serif;
        margin: 0;
        padding: 0;
      }

      html, body {
        max-width: 100%;
        overflow-x: hidden;
      }

      .login-page {
        background: url('images/login-bg.jpg') no-repeat center center fixed;
        background-size: cover;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        position: relative;
      }

      .login-page::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        z-index: 0;
      }

      .container {
        background: rgba(255, 255, 255, 0.9);
        padding: 40px 30px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        width: 100%;
        max-width: 400px;
        z-index: 1;
        position: relative;
      }

      .login-box h1 {
        margin-bottom: 10px;
        font-size: 28px;
        color: #222;
      }

      .login-box p {
        font-size: 14px;
        margin-bottom: 25px;
        color: #444;
      }

      .input-group {
        margin-bottom: 20px;
      }

      .input-group label {
        display: block;
        margin-bottom: 6px;
        color: #333;
        font-size: 14px;
      }

      .input-group input {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #bbb;
        font-size: 14px;
        transition: border 0.3s;
      }

      .input-group input:focus {
        border-color: #007bff;
        outline: none;
      }

      button {
        width: 100%;
        padding: 12px;
        border: none;
        background-color: #007bff;
        color: white;
        font-size: 16px;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.3s;
      }

      button:hover {
        background-color: #0056b3;
      }

      .bottom-text {
        margin-top: 20px;
        text-align: center;
        font-size: 14px;
        color: #333;
      }

      .bottom-text a {
        color: #007bff;
        text-decoration: none;
      }

      .bottom-text a:hover {
        text-decoration: underline;
      }

  body.login-page
    .container
      .login-box
        h1 Create Account
        p Register to start shopping with us!

        form#register-form
          .input-group
            label(for="username") Username
            input#username(type="text", placeholder="Enter your username")

          .input-group
            label(for="email") Email
            input#email(type="email", placeholder="Enter your email")

          .input-group
            label(for="Phone") Phone
            input#Phone(type="Phone", placeholder="Enter Phone Number")
          .input-group
            label(for="password") Password
            input#password(type="password", placeholder="Create a password")

          button(type="submit") Register

        .bottom-text
          p Already have an account? 
            a(href="login.html") Login here
    
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="scripts/register.js")
